@inject FactoryService FactoryService

<!-- Quick-add forms: recipe (at 1x, or via the editor modal), manual input, manual output -->
<div class="row g-3">
	<div class="col-md-4">
		<label class="form-label small">Add Recipe</label>
		<div class="row g-2">
			<div class="col-12 dropup-fix">
				<RecipeSelector FluidDivisor="@FluidDivisor" Recipes="@AllRecipes" @bind-SelectedRecipe="newRecipe"
					Placeholder="Select a recipe..." CssClass="form-select-sm" />
			</div>
			<div class="col-12 btn-group btn-group-sm" role="group">
				<button class="btn btn-secondary btn-sm" @onclick="AddRecipe">Add</button>
				<button class="btn btn-secondary btn-sm" @onclick="() => addRecipeModal.ShowAddAsync(newRecipe)">Advance</button>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<label class="form-label small">Add Custom Input</label>
		<div class="row g-2">
			<div class="col-12 dropup-fix">
				<PartSelector Parts="@AllParts" @bind-SelectedPart="newInputPart" Placeholder="Select input part..."
					CssClass="form-select-sm" />
			</div>
			<div class="col-6">
				<input type="number" class="form-control form-control-sm" @bind="newInputAmount"
					placeholder="Amount" step="0.1" min="0.1">
			</div>
			<div class="col-6">
				<button class="btn btn-secondary btn-sm w-100" @onclick="AddInput">Add</button>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<label class="form-label small">Add Custom Output</label>
		<div class="row g-2">
			<div class="col-12 dropup-fix">
				<PartSelector Parts="@AllParts" @bind-SelectedPart="newOutputPart" Placeholder="Select output part..."
					CssClass="form-select-sm" />
			</div>
			<div class="col-6">
				<input type="number" class="form-control form-control-sm" @bind="newOutputAmount"
					placeholder="Amount" step="0.1" min="0.1">
			</div>
			<div class="col-6">
				<button class="btn btn-secondary btn-sm w-100" @onclick="AddOutput">Add</button>
			</div>
		</div>
	</div>
</div>

<RecipeEditorModal @ref="addRecipeModal" Recipes="AllRecipes" FluidDivisor="@FluidDivisor" OnSave="OnAdvancedRecipeAdd" />

@code {
	[Parameter] public Factory SelectedFactory { get; set; } = null!;
	[Parameter] public List<DbRecipe> AllRecipes { get; set; } = [];
	[Parameter] public List<DbPart> AllParts { get; set; } = [];
	[Parameter] public int FluidDivisor { get; set; } = 1;
	/// <summary>A recipe, input or output was added; the owner reloads.</summary>
	[Parameter] public EventCallback OnAdded { get; set; }

	private RecipeEditorModal addRecipeModal = default!;

	private DbRecipe? newRecipe;
	private DbPart? newInputPart;
	private double newInputAmount;
	private DbPart? newOutputPart;
	private double newOutputAmount;

	private async Task AddRecipe() {
		if (newRecipe == null) {
			return;
		}
		await FactoryService.AddFactoryRecipeAsync(SelectedFactory.Id, newRecipe.Id, 1.0);
		newRecipe = null;
		await OnAdded.InvokeAsync();
	}

	private async Task OnAdvancedRecipeAdd((int recipeId, double multiplier, bool isSlooped, int? factoryRecipeId) args) {
		await FactoryService.AddFactoryRecipeAsync(SelectedFactory.Id, args.recipeId, args.multiplier, args.isSlooped);
		newRecipe = null;
		await OnAdded.InvokeAsync();
	}

	private async Task AddInput() {
		if (newInputPart == null || newInputAmount <= 0) {
			return;
		}
		await FactoryService.AddFactoryInputAsync(SelectedFactory.Id, newInputPart.Id, newInputAmount);
		newInputPart = null;
		newInputAmount = 0;
		await OnAdded.InvokeAsync();
	}

	private async Task AddOutput() {
		if (newOutputPart == null || newOutputAmount <= 0) {
			return;
		}
		await FactoryService.AddFactoryOutputAsync(SelectedFactory.Id, newOutputPart.Id, newOutputAmount);
		newOutputPart = null;
		newOutputAmount = 0;
		await OnAdded.InvokeAsync();
	}
}
