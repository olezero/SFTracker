<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/darkly/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" />
	<link rel="stylesheet" href="@Assets["app.css"]" />
	<link rel="stylesheet" href="@Assets["SFTracker.styles.css"]" />
	<link rel="stylesheet" href="_content/Blazor.Bootstrap/blazor.bootstrap.css" />

	<ImportMap />
	<link rel="icon" type="image/png" href="favicon.png" />
	<HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
	<Routes />
	<script src="_framework/blazor.web.js"></script>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
		integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
		crossorigin="anonymous"></script>
	<!-- sortable.js is needed by Blazor.Bootstrap's SortableList (factory/recipe drag-and-drop). -->
	<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
	<script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>
	<!-- gridstack.js drives the movable/resizable dashboard cards (DashboardGrid). -->
	<script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.js"></script>
	<script>
		window.sftracker = {
			focusAndSelect: function (id) {
				const el = document.getElementById(id);
				if (el) { el.focus(); el.select(); }
			},
			copyText: async function (text) {
				try {
					await navigator.clipboard.writeText(text);
				} catch {
					// Clipboard API needs a secure context; fall back to a hidden textarea + execCommand.
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					ta.remove();
				}
			},
			// Dashboard cards (DashboardGrid): Gridstack reads each item's initial gs-* attributes
			// from the markup, then reports every move/resize back to .NET to be saved.
			dashboard: {
				init: function (el, dotNetRef, columns, cellHeight) {
					const grid = GridStack.init({
						column: columns,
						cellHeight: cellHeight,
						margin: 8,
						float: true,
						animate: false,
						handle: '.card-header',
						resizable: { handles: 'se' },
						minRow: 1
					}, el);
					grid.on('change', () => {
						const layout = {};
						for (const node of grid.save(false)) {
							layout[node.id] = { x: node.x, y: node.y, w: node.w, h: node.h };
						}
						dotNetRef.invokeMethodAsync('OnLayoutChanged', layout).catch(() => { });
					});
					el._grid = grid;
				},
				destroy: function (el) {
					if (el && el._grid) {
						el._grid.destroy(false);
						delete el._grid;
					}
				}
			},
			// Hover tracking for Blazor.Bootstrap AutoComplete lists (RecipeListHover): the component
			// renders its own <li> items with no per-item events, so we watch the marker's parent
			// element and report the hovered item's text and viewport position to .NET.
			recipeHover: {
				attach: function (marker, dotNetRef) {
					const root = marker && marker.parentElement;
					if (!root) return;
					let current = null;
					const call = (name, ...args) => dotNetRef.invokeMethodAsync(name, ...args).catch(() => { });
					const leave = () => {
						if (current === null) return;
						current = null;
						call('OnItemLeave');
					};
					const over = (e) => {
						const li = e.target.closest('.autocomplete-list li');
						if (!li || !root.contains(li)) { leave(); return; }
						if (li === current) return;
						current = li;
						const r = li.getBoundingClientRect();
						call('OnItemHover', li.textContent.trim(), r.top, r.left);
					};
					root.addEventListener('mouseover', over);
					root.addEventListener('mouseleave', leave);
					root.addEventListener('hide.bs.dropdown', leave);
					root._recipeHover = { over, leave };
				},
				detach: function (marker) {
					const root = marker && marker.parentElement;
					const h = root && root._recipeHover;
					if (!h) return;
					root.removeEventListener('mouseover', h.over);
					root.removeEventListener('mouseleave', h.leave);
					root.removeEventListener('hide.bs.dropdown', h.leave);
					delete root._recipeHover;
				}
			}
		};
	</script>

</body>

</html>