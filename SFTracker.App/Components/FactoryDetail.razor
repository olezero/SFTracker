@* One card with one stable header no matter what is selected: the header is the Gridstack drag
   handle and Gridstack binds to the element it finds at init, so it must never be re-created. *@
<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h5 class="mb-0 @(SelectedFactory == null ? "text-muted" : "")">@(SelectedFactory?.Name ?? "Factory")</h5>
		@* Invisible when nothing is selected so the header keeps the same height. *@
		<div class="@(SelectedFactory == null ? "invisible" : "")">
			<button class="btn btn-secondary btn-sm me-2" @onclick="OnShowUpdateFactoryModal" tabindex="@(SelectedFactory == null ? -1 : 0)">
				<i class="bi bi-pencil"></i> Edit
			</button>
			<button class="btn btn-secondary btn-sm" @onclick="OnDeleteSelectedFactory" tabindex="@(SelectedFactory == null ? -1 : 0)">
				<i class="bi bi-trash"></i> Delete
			</button>
		</div>
	</div>
	@if (SelectedFactory != null)
	{
		@* Body scrolls (recipes + manual inputs/outputs); the add forms stay pinned in the footer. *@
		<div class="card-body">
			<RecipeSection SelectedFactory="@SelectedFactory" AllRecipes="@AllRecipes" FluidDivisor="@FluidDivisor"
				OnRecipeChanged="@OnChanged" />
			<CustomInputOutput SelectedFactory="@SelectedFactory" AllParts="@AllParts" OnChanged="@OnChanged" />
		</div>
		<div class="card-footer">
			<AddForms SelectedFactory="@SelectedFactory" AllRecipes="@AllRecipes" AllParts="@AllParts" FluidDivisor="@FluidDivisor"
				OnAdded="@OnChanged" />
		</div>
	}
	else
	{
		<div class="card-body text-center text-muted">
			<h5>Select a factory to view details</h5>
			<p>Choose a factory from the list on the left to view and edit its inputs and outputs.</p>
		</div>
	}
</div>

@code {
	[Parameter] public Factory? SelectedFactory { get; set; }
	[Parameter] public List<DbPart> AllParts { get; set; } = [];
	[Parameter] public List<DbRecipe> AllRecipes { get; set; } = [];
	[Parameter] public int FluidDivisor { get; set; } = 1;
	[Parameter] public EventCallback OnShowUpdateFactoryModal { get; set; }
	[Parameter] public EventCallback OnDeleteSelectedFactory { get; set; }
	/// <summary>Anything inside the factory changed (recipes, manual inputs/outputs); the owner reloads.</summary>
	[Parameter] public EventCallback OnChanged { get; set; }
}
