@inject FactoryService FactoryService
@inject GameService GameService
@inject NetworkService NetworkService

<GameSelector Games="@games" SelectedGame="@selectedGame" SelectedGameChanged="@OnGameSelected"
	OnGameOperation="@OnGameOperation" FluidDivisorChanged="@OnFluidDivisorChanged" />

<div class="row g-3">
	<div class="col-lg-3">
		<FactoryList @ref="factoryListComponent" Factories="@factories" SelectedFactory="@selectedFactory" Networks="@networks"
			SelectedFactoryChanged="@OnFactorySelected" OnFactoryListChanged="@OnFactoryListChanged"
			OnFactoryOperation="@OnFactoryOperation" />

		<div class="mt-3">
			<ResourceBalance @ref="resourceBalance" GameId="@(selectedGame?.Id ?? 0)" FluidDivisor="@FluidDivisor" />
		</div>
	</div>

	<div class="col-lg-9">
		<FactoryDetail SelectedFactory="@selectedFactory" AllParts="@allParts" AllRecipes="@allRecipes" FluidDivisor="@FluidDivisor"
			OnShowUpdateFactoryModal="@ShowUpdateFactoryModal" OnDeleteSelectedFactory="@DeleteSelectedFactory"
			OnChanged="@LoadDataAndRefreshBalance" />
	</div>
</div>

@code {
	private ResourceBalance? resourceBalance;
	private FactoryList? factoryListComponent;

	private List<Game> games = [];
	private Game? selectedGame;

	private List<Factory> factories = [];
	private List<Network> networks = [];
	private Factory? selectedFactory;

	// Game reference data; loaded once per circuit since it never changes while the app runs.
	private List<DbPart> allParts = [];
	private List<DbRecipe> allRecipes = [];

	private int FluidDivisor => selectedGame?.FluidDivisor ?? 1;

	protected override async Task OnInitializedAsync() {
		allParts = await FactoryService.GetAllPartsAsync();
		allRecipes = await FactoryService.GetAllRecipesAsync();
		await LoadGames();
		selectedGame = await GameService.GetMostRecentGameAsync();
		await LoadData();
	}

	private async Task LoadGames() {
		games = await GameService.GetAllGamesAsync();
	}

	private async Task LoadData() {
		factories = selectedGame == null ? [] : await FactoryService.GetAllFactoriesAsync(selectedGame.Id);
		networks = selectedGame == null ? [] : await NetworkService.GetAllNetworksAsync(selectedGame.Id);
		// Re-point the selection at the freshly loaded instance (null if it was deleted).
		selectedFactory = selectedFactory == null ? null : factories.FirstOrDefault(f => f.Id == selectedFactory.Id);
	}

	private async Task LoadDataAndRefreshBalance() {
		await LoadData();
		await TriggerBalanceRefresh();
	}

	private async Task TriggerBalanceRefresh() {
		if (resourceBalance != null) {
			await resourceBalance.RefreshBalance();
		}
	}

	private async Task OnGameSelected(Game? game) {
		selectedGame = game;
		selectedFactory = null;
		if (game != null) {
			await GameService.TouchGameAsync(game.Id);
		}
		// ResourceBalance refreshes itself when its GameId parameter changes on the re-render.
		await LoadData();
	}

	private async Task OnFluidDivisorChanged(int divisor) {
		if (selectedGame == null) {
			return;
		}
		await GameService.SetFluidDivisorAsync(selectedGame.Id, divisor);
		selectedGame.FluidDivisor = divisor;
		// ResourceBalance recalculates when its FluidDivisor parameter changes on the re-render.
	}

	private async Task OnGameOperation((Game game, string operation) args) {
		switch (args.operation) {
			case "create":
				var created = await GameService.CreateGameAsync(args.game.Name);
				await LoadGames();
				await OnGameSelected(games.FirstOrDefault(g => g.Id == created.Id));
				break;
			case "rename":
				await GameService.RenameGameAsync(args.game.Id, args.game.Name);
				await LoadGames();
				selectedGame = games.FirstOrDefault(g => g.Id == args.game.Id);
				break;
			case "delete":
				await GameService.DeleteGameAsync(args.game.Id);
				await LoadGames();
				await OnGameSelected(await GameService.GetMostRecentGameAsync());
				break;
			case "imported":
				// Already created by GameTransferService; just show it.
				await LoadGames();
				await OnGameSelected(games.FirstOrDefault(g => g.Id == args.game.Id));
				break;
		}
	}

	private void OnFactorySelected(Factory? factory) {
		selectedFactory = factory;
	}

	private async Task OnFactoryListChanged() {
		// FactoryList has already reordered the list in place.
		await FactoryService.ReorderFactoriesAsync(factories.Select(f => f.Id).ToList());
		await TriggerBalanceRefresh();
	}

	private async Task OnFactoryOperation((Factory factory, string operation) args) {
		switch (args.operation) {
			case "create":
				if (selectedGame == null) {
					return;
				}
				await FactoryService.CreateFactoryAsync(args.factory.Name, selectedGame.Id);
				break;
			case "delete":
				await FactoryService.DeleteFactoryAsync(args.factory.Id);
				selectedFactory = null;
				break;
			// "update": FactoryList has already saved the change; just reload.
		}
		await LoadDataAndRefreshBalance();
	}

	private async Task ShowUpdateFactoryModal() {
		if (factoryListComponent != null) {
			await factoryListComponent.ShowUpdateFactoryModal();
		}
	}

	private async Task DeleteSelectedFactory() {
		if (factoryListComponent != null) {
			await factoryListComponent.DeleteSelectedFactory();
		}
	}
}
