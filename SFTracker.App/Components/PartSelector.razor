@using SFTracker.Models
@using BlazorBootstrap

<AutoComplete TItem="DbPart"
			  @bind-Value="selectedText"
			  DataProvider="PartsDataProvider"
			  PropertyName="Name"
			  Placeholder="@Placeholder"
			  OnChanged="OnPartSelected"
			  class="@CssClass" />

@code {
	[Parameter] public List<DbPart> Parts { get; set; } = new();
	[Parameter] public DbPart? SelectedPart { get; set; }
	[Parameter] public EventCallback<DbPart?> SelectedPartChanged { get; set; }
	[Parameter] public string Placeholder { get; set; } = "Select a part...";
	[Parameter] public string CssClass { get; set; } = "";

	private string selectedText = string.Empty;

	protected override void OnParametersSet()
	{
		// Keep the textbox in sync when the bound part is set/cleared externally
		selectedText = SelectedPart?.Name ?? string.Empty;
	}

	private async Task<AutoCompleteDataProviderResult<DbPart>> PartsDataProvider(AutoCompleteDataProviderRequest<DbPart> request)
	{
		var filter = request.Filter?.Value ?? string.Empty;

		var data = (string.IsNullOrWhiteSpace(filter)
			? Parts
			: Parts.Where(p => p.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)))
			.OrderBy(p => p.Name)
			.ToList();

		return await Task.FromResult(new AutoCompleteDataProviderResult<DbPart> {
			Data = data,
			TotalCount = data.Count
		});
	}

	private async Task OnPartSelected(DbPart? part)
	{
		SelectedPart = part;
		selectedText = part?.Name ?? string.Empty;
		await SelectedPartChanged.InvokeAsync(part);
	}
}
