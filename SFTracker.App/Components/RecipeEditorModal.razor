@using static SFTracker.Constants.DisplayConstants
@inject IJSRuntime JSRuntime

@* Shared add/edit modal for a factory recipe. Opened via ShowAddAsync / ShowEditAsync, which hand it
   its state directly (no parameters), so a parent re-render can't reset in-progress edits. *@
<Modal @ref="modal" Title="@(isEditMode ? "Edit Factory Recipe" : "Add Factory Recipe")" Size="ModalSize.ExtraLarge" OnShown="OnModalShown">
	<BodyTemplate>
		<div class="mb-3">
			<label for="recipeSelect" class="form-label">Recipe</label>
			<RecipeSelector FluidDivisor="@FluidDivisor" Recipes="@Recipes" SelectedRecipe="@currentRecipe"
				SelectedRecipeChanged="OnRecipeSelect" CssClass="form-select-sm" />
		</div>
		@if (currentRecipe != null)
		{
			@* Enter in any of the rate fields saves. The recipe picker above is deliberately outside
			   this wrapper, since Enter there selects the highlighted recipe. *@
			<div @onkeydown="OnFieldKeyDown">
			<div class="mb-3">
				<div class="d-flex align-items-center">
					<label class="form-label mb-0 flex-grow-1">Multiplier</label>
					<input type="text" inputmode="decimal" id="@MultiplierElementId"
						class="form-control ms-2 form-control-sm @(highlightMultiplier ? "border-info" : "")" style="width: 120px;"
						value="@multiplierText" @oninput="OnMultiplierChange" title="@ExpressionHint">
				</div>
			</div>
			<div class="mb-3">
				<div class="form-check">
					<input class="form-check-input" type="checkbox" id="sloopedCheck"
						checked="@isSlooped" @onchange="OnSloopedChange">
					<label class="form-check-label" for="sloopedCheck">
						Slooped (2x output)
					</label>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<h6>Inputs</h6>
					@foreach (var input in currentRecipe.Inputs)
					{
						<div class="d-flex align-items-center mb-2">
							<img src="@input.Part.ImageUrl" alt="@input.Part.Name" class="me-2"
								style="width: 24px; height: 24px; object-fit: contain;" onerror="this.style.display='none'">
							<span class="flex-grow-1">@input.Part.Name</span>
							@if (Factory != null)
							{
								var isWorld = Factory.IsWorldPart(input.PartId);
								<button type="button" class="btn btn-sm me-2 recipe-world-toggle @(isWorld ? "btn-info" : "btn-outline-secondary")"
									title="@(isWorld ? "Imported from the world: the balance shows this part with the All Factories totals. Click to unmark." : "Mark as imported from the world (another factory or network): the balance then shows this part with the All Factories totals.")"
									@onclick="() => OnToggleWorldPart.InvokeAsync(input.PartId)">
									<i class="bi bi-globe"></i>
								</button>
							}
							<input type="text" inputmode="decimal" id="@InputElementId(input.Id)"
								class="form-control form-control-sm @(highlightInputId == input.Id ? "border-info" : "")" style="width: 120px;"
								value="@inputTexts[input.Id]"
								@oninput="e => OnInputChange(input, e)" title="@ExpressionHint">
						</div>
					}
				</div>
				<div class="col">
					<h6>Outputs</h6>
					@foreach (var output in currentRecipe.Outputs)
					{
						<div class="d-flex align-items-center mb-2">
							<img src="@output.Part.ImageUrl" alt="@output.Part.Name" class="me-2"
								style="width: 24px; height: 24px; object-fit: contain;" onerror="this.style.display='none'">
							<span class="flex-grow-1">@output.Part.Name</span>
							<input type="text" inputmode="decimal" id="@OutputElementId(output.Id)"
								class="form-control ms-2 form-control-sm @(highlightOutputId == output.Id ? "border-info" : "")" style="width: 120px;"
								value="@outputTexts[output.Id]"
								@oninput="e => OnOutputChange(output, e)" title="@ExpressionHint">
						</div>
					}
				</div>
			</div>
			</div>
		}
	</BodyTemplate>
	<FooterTemplate>
		@if (isEditMode && Factories.Any())
		{
			@* Move the row to another factory in the game. Only offered when editing an existing row. *@
			<div class="d-flex align-items-center me-auto">
				<label for="moveToFactory" class="form-label mb-0 me-2 text-nowrap">Move to</label>
				<select id="moveToFactory" class="form-select form-select-sm me-2" style="width: 220px;" @onchange="OnMoveTargetChange">
					<option value="">Select factory…</option>
					@foreach (var factory in Factories)
					{
						<option value="@factory.Id" selected="@(moveTargetFactoryId == factory.Id)">@factory.Name</option>
					}
				</select>
				<Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="Move" Disabled="@(moveTargetFactoryId == null)">
					<i class="bi bi-box-arrow-right"></i> Move
				</Button>
			</div>
		}
		<Button Color="ButtonColor.Secondary" @onclick="HideModal">Cancel</Button>
		<Button Color="ButtonColor.Primary" @onclick="Save" Disabled="@(multiplier <= 0)">@(isEditMode ? "Save" : "Add")</Button>
	</FooterTemplate>
</Modal>

@code {
	[Parameter] public IEnumerable<DbRecipe> Recipes { get; set; } = [];
	[Parameter] public int FluidDivisor { get; set; } = 1;
	/// <summary>Factories the edited row can be moved to (the current one excluded). Empty hides the move controls.</summary>
	[Parameter] public IEnumerable<Factory> Factories { get; set; } = [];
	/// <summary>Fires when the user moves the edited row to another factory: (factoryRecipeId, targetFactoryId).</summary>
	[Parameter] public EventCallback<(int factoryRecipeId, int targetFactoryId)> OnMove { get; set; }
	/// <summary>Fires on Save. factoryRecipeId is the edited row in edit mode and null in add mode.</summary>
	[Parameter] public EventCallback<(int recipeId, double multiplier, bool isSlooped, int? factoryRecipeId)> OnSave { get; set; }
	/// <summary>The factory the recipe belongs to; enables the per-input "imported from the world" toggles.</summary>
	[Parameter] public Factory? Factory { get; set; }
	/// <summary>Fires when a world toggle is clicked, with the part id. The parent persists it; the toggle reflects <see cref="Factory"/>.</summary>
	[Parameter] public EventCallback<int> OnToggleWorldPart { get; set; }

	private const string MultiplierElementId = "recipe-editor-multiplier";
	private static string InputElementId(int inputId) => $"recipe-editor-input-{inputId}";
	private static string OutputElementId(int outputId) => $"recipe-editor-output-{outputId}";

	private Modal modal = default!;
	private bool isEditMode;
	private int? factoryRecipeId;
	private int? moveTargetFactoryId;
	private DbRecipe? currentRecipe;
	private double multiplier = 1.0;
	private bool isSlooped;

	// What each field shows. Fields accept arithmetic ("190-30"), so the one being typed in keeps its
	// raw text while every other field is rewritten from the evaluated multiplier. An incomplete or
	// invalid expression leaves the multiplier (and so the other fields) at the last good value.
	private const string ExpressionHint = "A number or simple maths, e.g. 190-30 or 2*7.5";
	private string multiplierText = "1";
	private readonly Dictionary<int, string> inputTexts = [];
	private readonly Dictionary<int, string> outputTexts = [];

	// Field to highlight and focus when the modal opens.
	private int? highlightInputId;
	private int? highlightOutputId;
	private bool highlightMultiplier;

	/// <summary>Opens the modal in add mode, optionally with a recipe preselected at 1x.</summary>
	public Task ShowAddAsync(DbRecipe? recipe = null) =>
		ShowAsync(recipe, 1.0, false, null, null, null, false);

	/// <summary>Opens the modal to edit an existing factory recipe, optionally highlighting one field.</summary>
	public Task ShowEditAsync(FactoryRecipe factoryRecipe, int? highlightInputId = null, int? highlightOutputId = null, bool highlightMultiplier = false) =>
		ShowAsync(factoryRecipe.Recipe, factoryRecipe.Multiplier, factoryRecipe.IsSlooped, factoryRecipe.Id, highlightInputId, highlightOutputId, highlightMultiplier);

	private async Task ShowAsync(DbRecipe? recipe, double initialMultiplier, bool initialIsSlooped, int? editFactoryRecipeId,
		int? inputToHighlight, int? outputToHighlight, bool multiplierToHighlight) {
		isEditMode = editFactoryRecipeId != null;
		factoryRecipeId = editFactoryRecipeId;
		moveTargetFactoryId = null;
		currentRecipe = recipe;
		multiplier = initialMultiplier;
		isSlooped = initialIsSlooped;
		highlightInputId = inputToHighlight;
		highlightOutputId = outputToHighlight;
		highlightMultiplier = multiplierToHighlight;
		RecalculateRates();
		StateHasChanged();
		await modal.ShowAsync();
	}

	private void OnRecipeSelect(DbRecipe? recipe) {
		currentRecipe = recipe;
		multiplier = 1.0;
		isSlooped = false;
		RecalculateRates();
	}

	/// <summary>Rewrites every field's text from the current multiplier and sloop state.</summary>
	private void RecalculateRates() {
		multiplierText = FormatNumber(multiplier);
		inputTexts.Clear();
		outputTexts.Clear();
		if (currentRecipe == null) {
			return;
		}
		foreach (var input in currentRecipe.Inputs) {
			inputTexts[input.Id] = FormatNumber(input.GetQuantityPerMinute(multiplier, FluidDivisor));
		}
		foreach (var output in currentRecipe.Outputs) {
			outputTexts[output.Id] = FormatNumber(output.GetQuantityPerMinute(multiplier, isSlooped, FluidDivisor));
		}
	}

	private void OnMultiplierChange(ChangeEventArgs e) {
		var text = e.Value?.ToString() ?? "";
		if (ExpressionEvaluator.TryEvaluate(text, out var value)) {
			multiplier = value;
			RecalculateRates();
		}
		multiplierText = text;
	}

	private void OnSloopedChange(ChangeEventArgs e) {
		isSlooped = e.Value as bool? ?? false;
		RecalculateRates();
	}

	// Editing a rate back-calculates the multiplier. The edited field keeps the typed text so the
	// user's input isn't reformatted under them.
	private void OnInputChange(DbRecipeInput input, ChangeEventArgs e) {
		var text = e.Value?.ToString() ?? "";
		if (input.Quantity != 0 && ExpressionEvaluator.TryEvaluate(text, out var value)) {
			multiplier = value / input.GetQuantityPerMinute(1.0, FluidDivisor);
			RecalculateRates();
		}
		inputTexts[input.Id] = text;
	}

	private void OnOutputChange(DbRecipeOutput output, ChangeEventArgs e) {
		var text = e.Value?.ToString() ?? "";
		if (output.Quantity != 0 && ExpressionEvaluator.TryEvaluate(text, out var value)) {
			multiplier = value / output.GetQuantityPerMinute(1.0, isSlooped, FluidDivisor);
			RecalculateRates();
		}
		outputTexts[output.Id] = text;
	}

	private async Task HideModal() {
		await modal.HideAsync();
	}

	private async Task OnModalShown() {
		string? elementId = highlightMultiplier ? MultiplierElementId
			: highlightInputId is int inputId ? InputElementId(inputId)
			: highlightOutputId is int outputId ? OutputElementId(outputId)
			: null;
		if (elementId != null) {
			await JSRuntime.InvokeVoidAsync("sftracker.focusAndSelect", elementId);
		}
	}

	private async Task OnFieldKeyDown(KeyboardEventArgs e) {
		if (e.Key == "Enter") {
			await Save();
		}
	}

	private void OnMoveTargetChange(ChangeEventArgs e) {
		moveTargetFactoryId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
	}

	private async Task Move() {
		if (factoryRecipeId is not int id || moveTargetFactoryId is not int targetId) {
			return;
		}
		await OnMove.InvokeAsync((id, targetId));
		await HideModal();
	}

	private async Task Save() {
		if (currentRecipe == null || multiplier <= 0) {
			return;
		}
		await OnSave.InvokeAsync((currentRecipe.Id, multiplier, isSlooped, factoryRecipeId));
		await HideModal();
	}
}
