@using static SFTracker.Constants.DisplayConstants
@inject FactoryService FactoryService
@implements IDisposable

<!-- Recipe Sections -->
<SortableList TItem="FactoryRecipe" Data="OrderedRecipes" Context="factoryRecipe"
	Handle=".recipe-drag-handle" Class="recipe-sortable" OnUpdate="OnRecipeListUpdate">
	<ItemTemplate>
		@{
			// Main product = first output (index 0); recipes list their primary product first.
			var mainProduct = factoryRecipe.Recipe.Outputs.OrderBy(o => o.Id).FirstOrDefault()?.Part;
		}
		<div class="d-flex align-items-center mb-2 border-bottom pb-2 border-secondary">
			<!-- Main product icon (far left) - doubles as drag handle -->
			@if (mainProduct != null)
			{
				<img src="@mainProduct.ImageUrl" alt="@mainProduct.Name" title="Drag to reorder"
					class="me-3 flex-shrink-0 recipe-drag-handle"
					style="width: 48px; height: 48px; object-fit: contain;" onerror="this.style.visibility='hidden'">
			}

		<!-- Title + inputs/outputs -->
		<div class="flex-grow-1">
			<div class="fw-bold mb-1 d-flex align-items-center">
				<span>@factoryRecipe.Recipe.Name</span>
				@if (factoryRecipe.IsSlooped)
				{
					<img src="images/Somersloop.png" alt="Slooped" title="Slooped: output doubled" class="ms-2 recipe-sloop-icon">
				}
				<span class="badge bg-secondary ms-auto text-center" style="min-width: 3.25rem; cursor: pointer;"
					title="Machines needed - click to edit"
					@onclick="() => ShowEditRecipeModal(factoryRecipe, highlightMultiplier: true)">@FormatNumber(factoryRecipe.Multiplier) x</span>
			</div>
			<div class="row g-0">
				<!-- Recipe Inputs -->
				<div class="col-md-6">
					@foreach (var input in factoryRecipe.Recipe.Inputs)
					{
						var isEnabled = factoryRecipe.IsInputEnabled(input.Id);
						var producers = GetRecipesProducing(input.PartId);
						<div class="d-flex align-items-center mb-1">
							<div class="d-flex align-items-center flex-grow-1 @(isEnabled ? "" : "opacity-50")" style="cursor: pointer;"
								title="Click to edit this rate"
								@onclick="() => ShowEditRecipeModal(factoryRecipe, input.Id, null)">
								<img src="@input.Part.ImageUrl" alt="@input.Part.Name" class="me-2"
									style="width: 24px; height: 24px; object-fit: contain;" onerror="this.style.display='none'">
								<span class="me-2 flex-grow-1">@input.Part.Name</span>
								@RecipeRate(input.GetQuantityPerMinute(1, FluidDivisor), factoryRecipe.Multiplier, false,
									input.GetQuantityPerMinute(factoryRecipe, FluidDivisor), isEnabled)
							</div>
							<div class="btn-group ms-2 me-2 flex-shrink-0 ingredient-actions" role="group">
								<button type="button" class="btn btn-outline-secondary" data-bs-toggle="dropdown" data-bs-auto-close="true"
									disabled="@(producers.Count == 0)" title="Add a recipe that produces @input.Part.Name">
									<i class="bi bi-plus-lg"></i>
								</button>
								<ul class="dropdown-menu dropdown-menu-end" style="max-height: 320px; overflow-y: auto;" @onmouseleave="HideRecipeTip">
									<li><h6 class="dropdown-header">Produces @input.Part.Name</h6></li>
									@foreach (var recipe in producers)
									{
										<li><button type="button" class="dropdown-item"
											@onmouseenter="e => ShowRecipeTip(recipe, input.PartId, e)" @onmouseleave="HideRecipeTip"
											@onclick="() => AddRecipeForPart(recipe, input.PartId, asProducer: true)">@recipe.Name</button></li>
									}
								</ul>
								<button type="button" class="btn btn-outline-secondary"
									title="@(isEnabled ? "Hide from balance calculation" : "Show in balance calculation")"
									@onclick="() => ToggleRecipeInput(factoryRecipe.Id, input.Id)">
									<i class="bi @(isEnabled ? "bi-eye-slash" : "bi-eye")"></i>
								</button>
							</div>
						</div>
					}
				</div>

				<!-- Recipe Outputs -->
				<div class="col-md-6">
					@foreach (var output in factoryRecipe.Recipe.Outputs)
					{
						var isEnabled = factoryRecipe.IsOutputEnabled(output.Id);
						var consumers = GetRecipesConsuming(output.PartId);
						<div class="d-flex align-items-center mb-1">
							<div class="d-flex align-items-center flex-grow-1 @(isEnabled ? "" : "opacity-50")" style="cursor: pointer;"
								title="Click to edit this rate"
								@onclick="() => ShowEditRecipeModal(factoryRecipe, null, output.Id)">
								<img src="@output.Part.ImageUrl" alt="@output.Part.Name" class="me-2"
									style="width: 24px; height: 24px; object-fit: contain;" onerror="this.style.display='none'">
								<span class="me-2 flex-grow-1">@output.Part.Name</span>
								@RecipeRate(output.GetQuantityPerMinute(1, fluidDivisor: FluidDivisor), factoryRecipe.Multiplier, factoryRecipe.IsSlooped,
									output.GetQuantityPerMinute(factoryRecipe, FluidDivisor), isEnabled)
							</div>
							<div class="btn-group ms-2 flex-shrink-0 ingredient-actions" role="group">
								<button type="button" class="btn btn-outline-secondary" data-bs-toggle="dropdown" data-bs-auto-close="true"
									disabled="@(consumers.Count == 0)" title="Add a recipe that consumes @output.Part.Name">
									<i class="bi bi-plus-lg"></i>
								</button>
								<ul class="dropdown-menu dropdown-menu-end" style="max-height: 320px; overflow-y: auto;" @onmouseleave="HideRecipeTip">
									<li><h6 class="dropdown-header">Consumes @output.Part.Name</h6></li>
									@foreach (var recipe in consumers)
									{
										<li><button type="button" class="dropdown-item"
											@onmouseenter="e => ShowRecipeTip(recipe, output.PartId, e)" @onmouseleave="HideRecipeTip"
											@onclick="() => AddRecipeForPart(recipe, output.PartId, asProducer: false, insertAbove: factoryRecipe)">@recipe.Name</button></li>
									}
								</ul>
								<button type="button" class="btn btn-outline-secondary"
									title="@(isEnabled ? "Hide from balance calculation" : "Show in balance calculation")"
									@onclick="() => ToggleRecipeOutput(factoryRecipe.Id, output.Id)">
									<i class="bi @(isEnabled ? "bi-eye-slash" : "bi-eye")"></i>
								</button>
							</div>
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Edit / match demand / delete actions (far right, vertically centered) -->
		@{
			var demandMultiplier = GetDemandMultiplier(factoryRecipe);
		}
		<div class="ms-3 flex-shrink-0 btn-group btn-group-sm" role="group" aria-label="Edit, match demand or delete recipe">
			<button class="btn btn-outline-primary" title="Edit recipe"
				@onclick="() => ShowEditRecipeModal(factoryRecipe)">
				<i class="bi bi-pencil"></i>
			</button>
			<button class="btn btn-outline-info" disabled="@(demandMultiplier == null)"
				title="@GetDemandButtonTitle(factoryRecipe, demandMultiplier)"
				@onclick="() => MatchDemand(factoryRecipe, demandMultiplier)">
				<i class="bi bi-bullseye"></i>
			</button>
			<button class="btn @(pendingDeleteRecipeId == factoryRecipe.Id ? "btn-danger" : "btn-outline-danger")"
				title="Delete recipe" @onclick="() => HandleRemoveRecipeClick(factoryRecipe.Id)">
				<i class="bi @(pendingDeleteRecipeId == factoryRecipe.Id ? "bi-check-lg" : "bi-trash")"></i>
			</button>
		</div>
		</div>
	</ItemTemplate>
</SortableList>

@* Hover card for recipes in the per-ingredient "+" dropdowns. *@
@if (tipRecipe != null)
{
	<RecipeHoverCard Recipe="tipRecipe" HighlightPartId="tipPartId" Top="tipTop" Left="tipLeft" FluidDivisor="FluidDivisor" />
}

<RecipeEditorModal @ref="editRecipeModal" Recipes="AllRecipes" FluidDivisor="@FluidDivisor" OnSave="OnRecipeEdited"
	Factories="@Factories.Where(f => f.Id != SelectedFactory.Id)" OnMove="OnRecipeMoved" />

@code {
	[Parameter] public Factory SelectedFactory { get; set; } = null!;
	[Parameter] public List<DbRecipe> AllRecipes { get; set; } = [];
	/// <summary>All factories of the game; the editor modal offers the others as move targets.</summary>
	[Parameter] public List<Factory> Factories { get; set; } = [];
	[Parameter] public int FluidDivisor { get; set; } = 1;
	[Parameter] public EventCallback OnRecipeChanged { get; set; }

	// Recipes in manual display order; also the data source for the sortable list.
	private List<FactoryRecipe> OrderedRecipes =>
		SelectedFactory.Recipes.OrderBy(r => r.Sorting).ThenBy(r => r.Id).ToList();

	private RecipeEditorModal editRecipeModal = default!;

	// Recipe hover card state (for the per-ingredient "+" dropdowns)
	private DbRecipe? tipRecipe;
	private int tipPartId;
	private double tipTop;
	private double tipLeft;

	// Delete confirmation state
	private int? pendingDeleteRecipeId = null;
	private System.Threading.Timer? deleteConfirmationTimer;
	private const int DeleteConfirmationSeconds = 3;

	private async Task OnRecipeListUpdate(SortableListEventArgs args)
	{
		var ordered = OrderedRecipes;
		if (args.OldIndex < 0 || args.OldIndex >= ordered.Count)
			return;

		var moved = ordered[args.OldIndex];
		ordered.RemoveAt(args.OldIndex);
		var newIndex = Math.Clamp(args.NewIndex, 0, ordered.Count);
		ordered.Insert(newIndex, moved);

		// Optimistic UI: update the in-memory Sorting on the live instances (the same
		// ones OrderedRecipes is derived from) and re-render straight away. SortableList's
		// JS reverts the dragged element to its original DOM position, so without this the
		// row visibly snaps back until the DB reload lands. Persisting happens after.
		for (int i = 0; i < ordered.Count; i++)
		{
			ordered[i].Sorting = i;
		}
		StateHasChanged();

		await FactoryService.ReorderFactoryRecipesAsync(ordered.Select(r => r.Id).ToList());
		await OnRecipeChanged.InvokeAsync();
	}

	private async Task RemoveRecipe(int factoryRecipeId)
	{
		await FactoryService.RemoveFactoryRecipeAsync(factoryRecipeId);
		await OnRecipeChanged.InvokeAsync();
		pendingDeleteRecipeId = null;
		deleteConfirmationTimer?.Dispose();
	}

	private async Task HandleRemoveRecipeClick(int factoryRecipeId)
	{
		if (pendingDeleteRecipeId == factoryRecipeId)
		{
			// Second click - confirm deletion
			await RemoveRecipe(factoryRecipeId);
		}
		else
		{
			// First click - enter confirmation mode
			pendingDeleteRecipeId = factoryRecipeId;

			// Cancel any existing timer
			deleteConfirmationTimer?.Dispose();

			// Start new timer to reset confirmation after N seconds
			deleteConfirmationTimer = new System.Threading.Timer(_ =>
			{
				pendingDeleteRecipeId = null;
				InvokeAsync(StateHasChanged);
			}, null, TimeSpan.FromSeconds(DeleteConfirmationSeconds), Timeout.InfiniteTimeSpan);

			StateHasChanged();
		}
	}

	public void Dispose()
	{
		deleteConfirmationTimer?.Dispose();
	}

	/// <summary>
	/// Toggle whether a recipe input is enabled/disabled for balance calculations
	/// </summary>
	private async Task ToggleRecipeInput(int factoryRecipeId, int recipeInputId)
	{
		await FactoryService.ToggleRecipeInputAsync(factoryRecipeId, recipeInputId);
		await OnRecipeChanged.InvokeAsync();
	}

	/// <summary>
	/// Toggle whether a recipe output is enabled/disabled for balance calculations
	/// </summary>
	private async Task ToggleRecipeOutput(int factoryRecipeId, int recipeOutputId)
	{
		await FactoryService.ToggleRecipeOutputAsync(factoryRecipeId, recipeOutputId);
		await OnRecipeChanged.InvokeAsync();
	}

	private Task ShowEditRecipeModal(FactoryRecipe factoryRecipe, int? highlightInputId = null, int? highlightOutputId = null, bool highlightMultiplier = false) =>
		editRecipeModal.ShowEditAsync(factoryRecipe, highlightInputId, highlightOutputId, highlightMultiplier);

	private async Task OnRecipeEdited((int recipeId, double multiplier, bool isSlooped, int? factoryRecipeId) args)
	{
		if (args.factoryRecipeId is int factoryRecipeId)
		{
			await FactoryService.UpdateFactoryRecipeAsync(factoryRecipeId, args.multiplier, args.isSlooped, args.recipeId);
			await OnRecipeChanged.InvokeAsync();
		}
	}

	private async Task OnRecipeMoved((int factoryRecipeId, int targetFactoryId) args)
	{
		await FactoryService.MoveFactoryRecipeAsync(args.factoryRecipeId, args.targetFactoryId);
		await OnRecipeChanged.InvokeAsync();
	}

	// "perMachine × multiplier [× 2] = total" laid out in fixed-width columns so the rows of a
	// recipe line up; a plain 1x recipe shows only the total. The sloop marker sits inline after
	// the multiplier (it is per recipe, so every row of a slooped recipe carries it).
	private static RenderFragment RecipeRate(double perMachine, double multiplier, bool slooped, double total, bool isEnabled) =>
		@<span class="recipe-rate">
			@if (multiplier != 1.0 || slooped)
			{
				<span class="recipe-rate-per">@FormatNumber(perMachine)</span>
				<span class="recipe-rate-mult">× @FormatNumber(multiplier)@if (slooped)
					{<span class="recipe-rate-sloop" title="Slooped: output doubled"> × 2</span>}</span>
				<span>=</span>
			}
			<span class="recipe-rate-total"><span class="badge @(isEnabled ? "bg-secondary" : "bg-dark")">@FormatNumber(total)</span></span>
		</span>;

	/// <summary>
	/// Multiplier that makes this recipe's main product exactly cover the rest of the
	/// factory's demand for it (manual inputs + other recipes' enabled inputs, minus
	/// manual outputs and other recipes' enabled outputs). Null when there is nothing
	/// to cover or the recipe has no enabled output to cover it with.
	/// </summary>
	private double? GetDemandMultiplier(FactoryRecipe factoryRecipe)
	{
		var output = GetMainEnabledOutput(factoryRecipe);
		if (output == null)
			return null;

		var perMachine = output.GetQuantityPerMinute(1, factoryRecipe.IsSlooped, FluidDivisor);
		if (perMachine <= 0)
			return null;

		var required = GetUncoveredDemand(factoryRecipe, output.PartId);
		if (required <= 0.0001)
			return null;

		// Store the exact value; the row display rounds to 4 decimals but the rates are computed from this.
		return required / perMachine;
	}

	// First enabled output, in the same order the row uses for the main product icon.
	private DbRecipeOutput? GetMainEnabledOutput(FactoryRecipe factoryRecipe) =>
		factoryRecipe.Recipe.Outputs
			.OrderBy(o => o.Id)
			.FirstOrDefault(o => factoryRecipe.IsOutputEnabled(o.Id));

	// Demand for partId in the selected factory that is not met by anything other than the excluded recipe.
	private double GetUncoveredDemand(FactoryRecipe? excludedRecipe, int partId)
	{
		var demand = SelectedFactory.Inputs.Where(i => i.PartId == partId).Sum(i => i.AmountPerMinute);
		var supply = SelectedFactory.Outputs.Where(o => o.PartId == partId).Sum(o => o.AmountPerMinute);

		foreach (var other in SelectedFactory.Recipes)
		{
			demand += other.Recipe.Inputs
				.Where(ri => ri.PartId == partId && other.IsInputEnabled(ri.Id))
				.Sum(ri => ri.GetQuantityPerMinute(other, FluidDivisor));

			if (excludedRecipe != null && other.Id == excludedRecipe.Id)
				continue;

			supply += other.Recipe.Outputs
				.Where(ro => ro.PartId == partId && other.IsOutputEnabled(ro.Id))
				.Sum(ro => ro.GetQuantityPerMinute(other, FluidDivisor));
		}

		return demand - supply;
	}

	private List<DbRecipe> GetRecipesProducing(int partId) =>
		AllRecipes.Where(r => r.Outputs.Any(o => o.PartId == partId)).OrderBy(r => r.Name).ToList();

	private List<DbRecipe> GetRecipesConsuming(int partId) =>
		AllRecipes.Where(r => r.Inputs.Any(i => i.PartId == partId)).OrderBy(r => r.Name).ToList();

	private void ShowRecipeTip(DbRecipe recipe, int partId, MouseEventArgs e)
	{
		tipRecipe = recipe;
		tipPartId = partId;
		// Offset* are relative to the hovered item, so this is the item's top-left corner in viewport
		// coordinates; the card is placed to the left of it (see .recipe-tip in app.css).
		tipTop = e.ClientY - e.OffsetY;
		tipLeft = e.ClientX - e.OffsetX;
	}

	private void HideRecipeTip()
	{
		tipRecipe = null;
	}

	/// <summary>
	/// Add a recipe picked from an ingredient's dropdown. As a producer it is sized to cover the
	/// factory's current shortfall of the part; as a consumer it is sized to eat the current surplus.
	/// Falls back to 1x when there is no gap to fill.
	/// New recipes go to the bottom of the list unless <paramref name="insertAbove"/> is given, in
	/// which case the new recipe is placed directly above it (used for consumers, so they sit next
	/// to the recipe whose output they eat).
	/// </summary>
	private async Task AddRecipeForPart(DbRecipe recipe, int partId, bool asProducer, FactoryRecipe? insertAbove = null)
	{
		HideRecipeTip();
		var multiplier = 1.0;
		var gap = GetUncoveredDemand(null, partId); // positive = shortfall, negative = surplus

		if (asProducer)
		{
			var perMachine = recipe.Outputs.Where(o => o.PartId == partId).Sum(o => o.GetQuantityPerMinute(1, fluidDivisor: FluidDivisor));
			if (gap > 0.0001 && perMachine > 0)
				multiplier = gap / perMachine;
		}
		else
		{
			var perMachine = recipe.Inputs.Where(i => i.PartId == partId).Sum(i => i.GetQuantityPerMinute(1, FluidDivisor));
			if (-gap > 0.0001 && perMachine > 0)
				multiplier = -gap / perMachine;
		}

		var added = await FactoryService.AddFactoryRecipeAsync(SelectedFactory.Id, recipe.Id, multiplier);

		if (insertAbove != null)
		{
			// The shared DbContext's relationship fix-up has already appended the new row to
			// SelectedFactory.Recipes, so drop it before inserting it at the wanted position
			// (otherwise the trailing duplicate would win in ReorderFactoryRecipesAsync).
			var orderedIds = OrderedRecipes.Select(r => r.Id).Where(id => id != added.Id).ToList();
			var index = orderedIds.IndexOf(insertAbove.Id);
			orderedIds.Insert(index < 0 ? orderedIds.Count : index, added.Id);
			await FactoryService.ReorderFactoryRecipesAsync(orderedIds);
		}

		await OnRecipeChanged.InvokeAsync();
	}

	private string GetDemandButtonTitle(FactoryRecipe factoryRecipe, double? demandMultiplier)
	{
		var output = GetMainEnabledOutput(factoryRecipe);
		if (output == null)
			return "No enabled output to match demand with";
		if (demandMultiplier == null)
			return $"No uncovered demand for {output.Part.Name} in this factory";

		var rate = output.GetQuantityPerMinute(demandMultiplier.Value, factoryRecipe.IsSlooped, FluidDivisor);
		return $"Match demand: set to {FormatNumber(demandMultiplier.Value)} x ({FormatNumber(rate)} {output.Part.Name})";
	}

	private async Task MatchDemand(FactoryRecipe factoryRecipe, double? demandMultiplier)
	{
		if (demandMultiplier == null)
			return;

		await FactoryService.UpdateFactoryRecipeAsync(factoryRecipe.Id, demandMultiplier.Value, factoryRecipe.IsSlooped);
		await OnRecipeChanged.InvokeAsync();
	}
}
