@using SFTracker.Services
@using SFTracker.Models
@using SFTracker.Constants
@inject FactoryService FactoryService
@inject NetworkService NetworkService
@implements IDisposable


<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h5 class="mb-0">Resource Balance</h5>
		<button class="btn btn-outline-primary btn-sm" @onclick="RefreshBalance">
			<i class="bi bi-arrow-clockwise"></i>
		</button>
		@* Factory selection box *@
		<div>
			<select class="form-select form-select-sm" @bind="selectedFactory">
				<option value="all">All Factories</option>
				@if (networks.Any())
				{
					<optgroup label="Networks">
						@foreach (var network in networks)
						{
							<option value="@($"{NetworkScopePrefix}{network.Id}")">@network.Name</option>
						}
					</optgroup>
				}
				<optgroup label="Factories">
					@foreach (var factory in factories)
					{
						<option value="@factory.Id">@factory.Name</option>
					}
				</optgroup>
			</select>
		</div>
	</div>
	<div class="card-body p-0">
		@if (isLoading)
		{
			<div class="text-center p-3">
				<div class="spinner-border spinner-border-sm" role="status">
					<span class="visually-hidden">Loading...</span>
				</div>
				<div class="mt-2">Calculating...</div>
			</div>
		}
		else if (partBalances.Any())
		{
			<div class="row m-1">
				<div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
					<table class="table table-dark table-sm table-hover mb-0">
						<thead class="sticky-top">
							<tr>
								<th style="width: 40%;">Part</th>
								<th style="width: 15%;" class="">Prod</th>
								<th style="width: 5%;"></th>
								<th style="width: 15%;" class="text-end">Con</th>
								<th style="width: 25%;" class="text-end">Balance</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var part in partBalances.Where(IsCategoryShown).OrderByDescending(p => p.Balance).ThenBy(p => p.PartName))
							{
								var category = GetCategory(part);
								<tr>
									<td style="max-width: 0;">
										<div class="d-flex align-items-center">
											<img src="@part.ImageUrl" alt="@part.PartName" class="me-2 flex-shrink-0"
												style="width: 20px; height: 20px; object-fit: contain;"
												onerror="this.style.display='none'">
											<span class="text-truncate flex-grow-1" title="@part.PartName">@part.PartName</span>
										</div>
									</td>
									<td>
										<span class="text-info">@part.Production.ToString(DisplayConstants.DecimalFormat)</span>
									</td>
									<td>
										<i class="bi bi-arrow-right-short"></i>
									</td>
									<td class="text-end">
										<span
											class="text-info">@part.Consumption.ToString(DisplayConstants.DecimalFormat)</span>
									</td>
									<td class="text-end">
										@if (category == BalanceCategory.Balanced)
										{
											<span class="text-secondary fw-bold">0.0</span>
										}
										else if (category == BalanceCategory.Surplus)
										{
											<span
												class="text-success fw-bold">+@part.Balance.ToString(DisplayConstants.DecimalFormat)</span>
										}
										else
										{
											<span
												class="text-danger fw-bold">@part.Balance.ToString(DisplayConstants.DecimalFormat)</span>
										}
									</td>
								</tr>
							}
							@if (!partBalances.Any(IsCategoryShown))
							{
								<tr><td colspan="5" class="text-center text-muted py-3"><small>All rows hidden — click a category below to show it</small></td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Summary footer: counts per category; click a tile to hide/show those rows -->
			<div class="card-footer bg-dark p-2">
				<div class="row text-center g-0">
					@foreach (var category in new[] { BalanceCategory.Surplus, BalanceCategory.Deficit, BalanceCategory.Balanced })
					{
						var shown = IsCategoryShown(category);
						<div class="col-4">
							<button type="button" class="btn btn-link text-decoration-none p-0 w-100 lh-sm @(shown ? "" : "opacity-50")"
								title="@(shown ? $"Hide {category.ToString().ToLower()} rows" : $"Show {category.ToString().ToLower()} rows")"
								@onclick="() => ToggleCategory(category)">
								<small class="@CategoryTextClass(category) fw-bold">@partBalances.Count(p => GetCategory(p) == category)</small>
								<div><small class="text-muted">@category @(shown ? "" : "(hidden)")</small></div>
							</button>
						</div>
					}
				</div>
			</div>
		}
		else
		{
			<div class="text-center text-muted p-3">
				<i class="bi bi-info-circle-fill mb-2 d-block" style="font-size: 2rem;"></i>
				<p class="mb-0">No factories configured</p>
				<small>Create factories to see resource balance</small>
			</div>
		}
	</div>
</div>


@code {
	[Parameter] public int GameId { get; set; }
	[Parameter] public int FluidDivisor { get; set; } = 1;

	private List<Factory> factories = new();
	private List<Network> networks = new();
	private int lastGameId = -1;
	private int lastFluidDivisor = -1;
	private List<PartBalance> partBalances = new();
	private bool isLoading = true;

	// Which balance categories are listed; toggled from the footer tiles.
	private enum BalanceCategory { Surplus, Deficit, Balanced }
	private readonly HashSet<BalanceCategory> hiddenCategories = new();

	private static BalanceCategory GetCategory(PartBalance part) =>
		part.Balance > DisplayConstants.BalanceThreshold ? BalanceCategory.Surplus
		: part.Balance < -DisplayConstants.BalanceThreshold ? BalanceCategory.Deficit
		: BalanceCategory.Balanced;

	private bool IsCategoryShown(BalanceCategory category) => !hiddenCategories.Contains(category);
	private bool IsCategoryShown(PartBalance part) => IsCategoryShown(GetCategory(part));

	private void ToggleCategory(BalanceCategory category)
	{
		if (!hiddenCategories.Remove(category))
			hiddenCategories.Add(category);
	}

	private static string CategoryTextClass(BalanceCategory category) => category switch {
		BalanceCategory.Surplus => "text-success",
		BalanceCategory.Deficit => "text-danger",
		_ => "text-secondary"
	};
	private CancellationTokenSource? _debounceTokenSource;

	// Selector value: "all", "network:<id>" or "<factoryId>".
	private const string NetworkScopePrefix = "network:";
	private string selectedFactoryBacking = "all";
	private string selectedFactory
	{
		get => selectedFactoryBacking;
		set
		{
			if (selectedFactoryBacking != value)
			{
				selectedFactoryBacking = value;
				_ = RefreshBalanceDebounced();
			}
		}
	}


	public class PartBalance
	{
		public string PartName { get; set; } = "";
		public string ImageUrl { get; set; } = "";
		public double Consumption { get; set; }
		public double Production { get; set; }
		public double Balance => Production - Consumption;
		public string Tier { get; set; } = "";
	}

	protected override async Task OnParametersSetAsync()
	{
		// Runs on first render (GameId 0 -> empty) and again whenever the active game changes.
		// Switching game also invalidates the per-factory selection.
		if (GameId != lastGameId)
		{
			lastGameId = GameId;
			lastFluidDivisor = FluidDivisor;
			selectedFactoryBacking = "all";
			await RefreshBalance();
		}
		else if (FluidDivisor != lastFluidDivisor)
		{
			lastFluidDivisor = FluidDivisor;
			await RefreshBalance();
		}
	}


	public async Task RefreshBalance()
	{
		isLoading = true;
		StateHasChanged();

		try
		{
			await LoadData();
			await LoadPartBalances();
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}
	private async Task LoadPartBalances()
	{
		var factories = new List<Factory>();
		if (selectedFactoryBacking.StartsWith(NetworkScopePrefix)
			&& int.TryParse(selectedFactoryBacking.Substring(NetworkScopePrefix.Length), out var networkId))
		{
			// All factories in the selected network, balanced as one unit
			factories = (await FactoryService.GetAllFactoriesAsync(GameId).ConfigureAwait(false))
				.Where(f => f.NetworkId == networkId)
				.ToList();
		}
		else if (selectedFactoryBacking != "all" && int.TryParse(selectedFactoryBacking, out var selectedFactoryId))
		{
			// Filter to the selected factory
			var factory = await FactoryService.GetFactoryByIdAsync(selectedFactoryId).ConfigureAwait(false);
			if (factory != null)
			{
				factories.Add(factory);
			}
		}
		else
		{
			// Use all factories
			factories = await FactoryService.GetAllFactoriesAsync(GameId).ConfigureAwait(false);
		}

		@* var factories = await FactoryService.GetAllFactoriesAsync(GameId).ConfigureAwait(false); *@
		var allParts = await FactoryService.GetAllPartsAsync().ConfigureAwait(false);

		// Get all parts that are used in any factory (inputs, outputs, or recipes)
		var usedPartIds = new HashSet<int>();

		foreach (var factory in factories)
		{
			// Custom inputs and outputs
			foreach (var input in factory.Inputs)
				usedPartIds.Add(input.PartId);
			foreach (var output in factory.Outputs)
				usedPartIds.Add(output.PartId);

			// Recipe inputs and outputs
			foreach (var factoryRecipe in factory.Recipes)
			{
				foreach (var recipeInput in factoryRecipe.Recipe.Inputs)
					usedPartIds.Add(recipeInput.PartId);
				foreach (var recipeOutput in factoryRecipe.Recipe.Outputs)
					usedPartIds.Add(recipeOutput.PartId);
			}
		}

		partBalances = new List<PartBalance>();
		foreach (var partId in usedPartIds)
		{
			var part = allParts.FirstOrDefault(p => p.Id == partId);
			if (part == null) continue;

			// Calculate custom consumption (manual inputs)
			var customConsumption = factories.SelectMany(f => f.Inputs)
			.Where(i => i.PartId == partId)
			.Sum(i => i.AmountPerMinute);

			// Calculate custom production (manual outputs)
			var customProduction = factories.SelectMany(f => f.Outputs)
			.Where(o => o.PartId == partId)
			.Sum(o => o.AmountPerMinute);

			// Calculate recipe consumption (recipe inputs) - only include enabled inputs
			var recipeConsumption = factories.SelectMany(f => f.Recipes)
			.SelectMany(fr => fr.Recipe.Inputs.Where(ri => ri.PartId == partId)
			.Where(ri =>
			{
				var override_ = fr.InputOverrides.FirstOrDefault(o => o.RecipeInputId == ri.Id);
				return override_?.IsEnabled ?? true; // Default to enabled if no override
			})
			.Select(ri => ri.GetQuantityPerMinute(fr.Multiplier, FluidDivisor)))
			.Sum();

			// Calculate recipe production (recipe outputs) - only include enabled outputs
			var recipeProduction = factories.SelectMany(f => f.Recipes)
			.SelectMany(fr => fr.Recipe.Outputs.Where(ro => ro.PartId == partId)
			.Where(ro =>
			{
				var override_ = fr.OutputOverrides.FirstOrDefault(o => o.RecipeOutputId == ro.Id);
				return override_?.IsEnabled ?? true; // Default to enabled if no override
			})
			.Select(ro => ro.GetQuantityPerMinute(fr, FluidDivisor)))
			.Sum();

			// Total consumption and production
			var totalConsumption = customConsumption + recipeConsumption;
			var totalProduction = customProduction + recipeProduction;

			if (totalConsumption == 0 && totalProduction == 0)
			{
				continue; // Skip parts with no activity
			}

			partBalances.Add(new PartBalance
			{
				PartName = part.Name,
				ImageUrl = part.ImageUrl ?? "",
				Consumption = totalConsumption,
				Production = totalProduction,
				Tier = part.Tier ?? ""
			});
		}
	}
	public async Task RefreshBalanceDebounced(int delayMs = 100)
	{
		// Cancel any existing debounce operation
		_debounceTokenSource?.Cancel();
		_debounceTokenSource?.Dispose();
		_debounceTokenSource = new CancellationTokenSource();

		try
		{
			// Remove the delay since you commented it out, just refresh immediately
			await RefreshBalance();
		}
		catch (TaskCanceledException)
		{
			// Task was cancelled, which is expected when debouncing
		}
		catch (ObjectDisposedException)
		{
			// Component was disposed, ignore
		}
	}
	public void Dispose()
	{
		try
		{
			_debounceTokenSource?.Cancel();
			_debounceTokenSource?.Dispose();
		}
		catch (ObjectDisposedException)
		{
			// Already disposed, ignore
		}
		finally
		{
			_debounceTokenSource = null;
		}
	}


	private async Task LoadData()
	{
		factories = await FactoryService.GetAllFactoriesAsync(GameId).ConfigureAwait(false);
		networks = await NetworkService.GetAllNetworksAsync(GameId).ConfigureAwait(false);

		// The selected network may have been deleted; fall back to everything.
		if (selectedFactoryBacking.StartsWith(NetworkScopePrefix)
			&& !networks.Any(n => $"{NetworkScopePrefix}{n.Id}" == selectedFactoryBacking))
		{
			selectedFactoryBacking = "all";
		}
	}
}