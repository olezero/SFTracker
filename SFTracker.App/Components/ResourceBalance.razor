@inject FactoryService FactoryService
@inject NetworkService NetworkService

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h5 class="mb-0">Resource Balance</h5>
		<button class="btn btn-outline-primary btn-sm" @onclick="RefreshBalance">
			<i class="bi bi-arrow-clockwise"></i>
		</button>
		@* Scope: everything, one network, or one factory *@
		<div>
			<select class="form-select form-select-sm" @bind="selectedScope" @bind:after="Recalculate">
				<option value="@AllScope">All Factories</option>
				@if (networks.Count > 0)
				{
					<optgroup label="Networks">
						@foreach (var network in networks)
						{
							<option value="@(NetworkScopePrefix + network.Id)">@network.Name</option>
						}
					</optgroup>
				}
				<optgroup label="Factories">
					@foreach (var factory in factories)
					{
						<option value="@factory.Id">@factory.Name</option>
					}
				</optgroup>
			</select>
		</div>
	</div>
	<div class="card-body p-0">
		@if (hasLoaded && partBalances.Count > 0)
		{
			<table class="table table-dark table-sm table-hover mb-0">
				<thead class="sticky-top">
					<tr>
						<th style="width: 40%;">Part</th>
						<th style="width: 15%;">Prod</th>
						<th style="width: 5%;"></th>
						<th style="width: 15%;" class="text-end">Con</th>
						<th style="width: 25%;" class="text-end">Balance</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var part in partBalances.Where(IsCategoryShown).OrderByDescending(p => p.Balance).ThenBy(p => p.Part.Name))
					{
						var category = GetCategory(part);
						<tr>
							<td style="max-width: 0;">
								<div class="d-flex align-items-center">
									<img src="@part.Part.ImageUrl" alt="@part.Part.Name" class="me-2 flex-shrink-0"
										style="width: 20px; height: 20px; object-fit: contain;"
										onerror="this.style.display='none'">
									<span class="text-truncate flex-grow-1" title="@part.Part.Name">@part.Part.Name</span>
								</div>
							</td>
							<td>
								<span class="text-info">@part.Production.ToString(DisplayConstants.DecimalFormat)</span>
							</td>
							<td>
								<i class="bi bi-arrow-right-short"></i>
							</td>
							<td class="text-end">
								<span class="text-info">@part.Consumption.ToString(DisplayConstants.DecimalFormat)</span>
							</td>
							<td class="text-end">
								@if (category == BalanceCategory.Balanced)
								{
									<span class="text-secondary fw-bold">0.0</span>
								}
								else if (category == BalanceCategory.Surplus)
								{
									<span class="text-success fw-bold">+@part.Balance.ToString(DisplayConstants.DecimalFormat)</span>
								}
								else
								{
									<span class="text-danger fw-bold">@part.Balance.ToString(DisplayConstants.DecimalFormat)</span>
								}
							</td>
						</tr>
					}
					@if (!partBalances.Any(IsCategoryShown))
					{
						<tr><td colspan="5" class="text-center text-muted py-3"><small>All rows hidden — click a category below to show it</small></td></tr>
					}
				</tbody>
			</table>
		}
		else if (hasLoaded)
		{
			<div class="text-center text-muted p-3">
				<i class="bi bi-info-circle-fill mb-2 d-block" style="font-size: 2rem;"></i>
				<p class="mb-0">No factories configured</p>
				<small>Create factories to see resource balance</small>
			</div>
		}
	</div>
	@if (hasLoaded && partBalances.Count > 0)
	{
		<!-- Summary footer: counts per category; click a tile to hide/show those rows -->
		<div class="card-footer bg-dark p-2">
			<div class="row text-center g-0">
				@foreach (var category in new[] { BalanceCategory.Surplus, BalanceCategory.Deficit, BalanceCategory.Balanced })
				{
					var shown = IsCategoryShown(category);
					<div class="col-4">
						<button type="button" class="btn btn-link text-decoration-none p-0 w-100 lh-sm @(shown ? "" : "opacity-50")"
							title="@(shown ? $"Hide {category.ToString().ToLower()} rows" : $"Show {category.ToString().ToLower()} rows")"
							@onclick="() => ToggleCategory(category)">
							<small class="@CategoryTextClass(category) fw-bold">@partBalances.Count(p => GetCategory(p) == category)</small>
							<div><small class="text-muted">@category @(shown ? "" : "(hidden)")</small></div>
						</button>
					</div>
				}
			</div>
		</div>
	}
</div>

@code {
	[Parameter] public int GameId { get; set; }
	[Parameter] public int FluidDivisor { get; set; } = 1;

	// Selector value: "all", "network:<id>" or "<factoryId>".
	private const string AllScope = "all";
	private const string NetworkScopePrefix = "network:";
	private string selectedScope = AllScope;

	private List<Factory> factories = [];
	private List<Network> networks = [];
	private List<PartBalance> partBalances = [];
	private int lastGameId = -1;
	private int lastFluidDivisor = -1;
	private bool hasLoaded;

	// Which balance categories are listed; toggled from the footer tiles.
	private enum BalanceCategory { Surplus, Deficit, Balanced }
	private readonly HashSet<BalanceCategory> hiddenCategories = [];

	private static BalanceCategory GetCategory(PartBalance part) =>
		part.Balance > DisplayConstants.BalanceThreshold ? BalanceCategory.Surplus
		: part.Balance < -DisplayConstants.BalanceThreshold ? BalanceCategory.Deficit
		: BalanceCategory.Balanced;

	private bool IsCategoryShown(BalanceCategory category) => !hiddenCategories.Contains(category);
	private bool IsCategoryShown(PartBalance part) => IsCategoryShown(GetCategory(part));

	private void ToggleCategory(BalanceCategory category) {
		if (!hiddenCategories.Remove(category)) {
			hiddenCategories.Add(category);
		}
	}

	private static string CategoryTextClass(BalanceCategory category) => category switch {
		BalanceCategory.Surplus => "text-success",
		BalanceCategory.Deficit => "text-danger",
		_ => "text-secondary"
	};

	protected override async Task OnParametersSetAsync() {
		// Runs on first render (GameId 0 -> empty) and again whenever the active game changes.
		// Switching game also invalidates the scope selection.
		if (GameId != lastGameId) {
			lastGameId = GameId;
			lastFluidDivisor = FluidDivisor;
			selectedScope = AllScope;
			await RefreshBalance();
		} else if (FluidDivisor != lastFluidDivisor) {
			lastFluidDivisor = FluidDivisor;
			Recalculate();
		}
	}

	/// <summary>Reloads factories and networks from the database and recalculates the balance.</summary>
	public async Task RefreshBalance() {
		factories = await FactoryService.GetAllFactoriesAsync(GameId);
		networks = await NetworkService.GetAllNetworksAsync(GameId);
		// The selected network/factory may have been deleted; fall back to everything.
		if (!IsValidScope(selectedScope)) {
			selectedScope = AllScope;
		}
		Recalculate();
		hasLoaded = true;
		StateHasChanged();
	}

	/// <summary>Recomputes the balance for the selected scope from the already loaded factories.</summary>
	private void Recalculate() {
		partBalances = BalanceCalculator.Calculate(ScopedFactories(), FluidDivisor);
	}

	private IEnumerable<Factory> ScopedFactories() {
		if (TryParseNetworkScope(selectedScope, out var networkId)) {
			return factories.Where(f => f.NetworkId == networkId);
		}
		if (int.TryParse(selectedScope, out var factoryId)) {
			return factories.Where(f => f.Id == factoryId);
		}
		return factories;
	}

	private bool IsValidScope(string scope) =>
		scope == AllScope
		|| (TryParseNetworkScope(scope, out var networkId) && networks.Any(n => n.Id == networkId))
		|| (int.TryParse(scope, out var factoryId) && factories.Any(f => f.Id == factoryId));

	private static bool TryParseNetworkScope(string scope, out int networkId) {
		networkId = 0;
		return scope.StartsWith(NetworkScopePrefix) && int.TryParse(scope[NetworkScopePrefix.Length..], out networkId);
	}
}
