<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.Bootstrap" Version="4.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<!-- Per-machine settings the app writes at runtime (dashboard layout); never a reason for dotnet watch to react. -->
		<Content Update="usersettings.json" Watch="false" />
	</ItemGroup>
</Project>
