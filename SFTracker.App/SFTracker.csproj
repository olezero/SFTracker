<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.Bootstrap" Version="3.5.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.17" />
	</ItemGroup>

	<ItemGroup>
		<!-- Per-machine settings the app writes at runtime (dashboard layout); never a reason for dotnet watch to react. -->
		<Content Update="usersettings.json" Watch="false" />
	</ItemGroup>
</Project>
